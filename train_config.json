{
  "python_version": "3.8.18",
  "optimizer": "Adam",
  "learning_rate": 0.001,
  "batch_size": 32,
  "max_epochs": 50,
  "global_random_seed_main_experiment": 42,
  "loss_function": "categorical_crossentropy",
  "early_stopping": {
    "monitor": "val_loss",
    "patience": 5,
    "restore_best_weights": true
  },
  "framework": {
    "CNN_training": "tf.keras (TensorFlow backend)",
    "ProtT5_feature_extraction": "PyTorch 2.4.1"
  },
  "core_dependencies": {
    "numpy": "1.24.4",
    "pandas": "2.0.3"
  }
}
